# NEXORA Pursuit Engine Environment Configuration

ENVIRONMENT=development
PORT=8000

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./nexora_pursuit.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://nexora:nexorapassword@localhost:5432/nexoradb

# Redis Working & Session Memory
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET=nexora_super_secret_jwt_key_32_bytes_min_length_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration (mock, grok, openai, claude)
LLM_PROVIDER=mock
GROK_API_KEY=

# Event Bus Configuration (in_memory, kafka, rabbitmq)
EVENT_BUS=in_memory

# Integration Providers (mock, real)
EMAIL_PROVIDER=mock
CALENDAR_PROVIDER=mock
LINKEDIN_PROVIDER=mock

# Default Multi-tenant ID
DEFAULT_TENANT_ID=tenant_nexora_default

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
